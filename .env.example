# Copy to `.env` and fill every REQUIRED value. Do not commit `.env`.
# Empty values are placeholders — never real credentials.
#
# With FEATURE_* all true (below), startup validates every REQUIRED item.
# Disabled features do not require their provider credentials.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# REQUIRED. Neon dashboard → Connection string. Prefer SQLAlchemy async form:
#   postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
# A neon `postgresql://...?sslmode=require` URL is also accepted and rewritten.
DATABASE_URL=
# OPTIONAL. Same as DATABASE_URL unless you have a distinct sweep role.
DATABASE_URL_SWEEP=

# ---------------------------------------------------------------------------
# Redis (cloud)
# ---------------------------------------------------------------------------
# REQUIRED. Paste the URL only (not a redis-cli command).
# TLS example: rediss://default:PASSWORD@HOST:PORT
# Non-TLS: redis://default:PASSWORD@HOST:PORT
REDIS_URL=

# ---------------------------------------------------------------------------
# LLM (LiteLLM proxy — logical aliases only; no provider names in code)
# ---------------------------------------------------------------------------
# REQUIRED when FEATURE_STORY_PLANNING=true or FEATURE_QC_REPAIR=true.
# You do not need LiteLLM Cloud. Start the local OpenAI-compatible proxy:
#   export GEMINI_API_KEY=...    # https://aistudio.google.com/apikey
#   ./scripts/run_litellm.sh
# Do not use the LiteLLM CLI here — it treats Neon DATABASE_URL as Prisma.
LITELLM_PROXY_URL=http://127.0.0.1:4000
# Leave empty for the local proxy (no master key in config/litellm.yaml).
LITELLM_MASTER_KEY=
# OPTIONAL alias of LITELLM_MASTER_KEY (use if you run a proxy that requires one).
LITELLM_API_KEY=
# OPTIONAL. Leave unset unless you want same-capability fallbacks.
# Example: GATEWAY_FALLBACK_ALIASES={"reasoning-high":"reasoning-fast"}
# GATEWAY_FALLBACK_ALIASES=

# ---------------------------------------------------------------------------
# Video Provider (Higgsfield MCP behind VideoProvider)
# ---------------------------------------------------------------------------
# REQUIRED when FEATURE_SHOT_GENERATION=true.
# Unlike LiteLLM, there is no free local video MCP. Higgsfield bills credits.
#
# Public MCP HTTP endpoint (not a secret). The app POSTs JSON-RPC
#   method=tools/call  name=generate_video
#   Authorization: Bearer {VIDEO_MCP_API_KEY}
# If your team gave you a different MCP gateway URL, use that instead.
VIDEO_MCP_URL=https://mcp.higgsfield.ai/mcp
# REQUIRED. Higgsfield Cloud → API credentials:
#   https://cloud.higgsfield.ai
# Paste the Bearer token / API key your MCP gateway expects.
# (Higgsfield's Claude connector uses OAuth instead — that flow is not this app.)
VIDEO_MCP_API_KEY=
# OPTIONAL. Higgsfield video model id, sent as generate_video params.model.
# Default is Seedance 2.0 when that model is in the account catalog; otherwise
# the adapter picks Cinema Studio (or the first usable video model).
VIDEO_MCP_MODEL=seedance_2_0
# OPTIONAL timeout for generation + download (seconds).
VIDEO_MCP_TIMEOUT_SECONDS=300
# OPTIONAL legacy aliases of VIDEO_MCP_*.
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_API_KEY=

# ---------------------------------------------------------------------------
# FFMPEG (host binary — do not install via Docker)
# ---------------------------------------------------------------------------
# REQUIRED on PATH when shot generation or assemble is enabled. Override if not named ffmpeg.
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local disk for clips, frames, QC artifacts, and the stitched MP4 (v1).
MEDIA_ROOT=./data/media
# OPTIONAL. Unused in v1 local delivery (HMAC URLs on local disk).
STORAGE_BUCKET=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED when FEATURE_ASSEMBLE_DELIVER=true. Any long random string you generate
# (HMAC for download URLs). Not a provider API key.
PRESIGN_SECRET=
PRESIGNED_URL_TTL_SECONDS=3600
# UUID you will send as X-Tenant-Id. REQUIRED for `python -m app seed-tenant`.
# The API still requires the X-Tenant-Id header on every job request.
TENANT_ID=
TENANT_NAME=dev

# ---------------------------------------------------------------------------
# Feature Flags — full V1 pipeline
# ---------------------------------------------------------------------------
FEATURE_STORY_PLANNING=true
FEATURE_SHOT_GENERATION=true
FEATURE_QC_REPAIR=true
FEATURE_ASSEMBLE_DELIVER=true

# ---------------------------------------------------------------------------
# Worker / Queue
# ---------------------------------------------------------------------------
# Jobs run inside the FastAPI process (asyncio). No Celery/RQ/ARQ.
# No extra worker env vars. No second process.

# ---------------------------------------------------------------------------
# Observability (OPTIONAL — local prompt templates used when unset)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

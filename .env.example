# --- App ---
APP_ENV=development
FEATURE_STORY_PLANNING=true

# --- LiteLLM gateway (single egress for every model call) ---
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# --- Postgres 16 (system of record, RLS per tenant) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_agent

# Optional: DSN for the startup sweep only, connecting as a role with
# BYPASSRLS (FORCE ROW LEVEL SECURITY blocks every role, including the
# table owner, once set). Leave unset in dev/tests to fall back to
# DATABASE_URL; set this in production or the sweep will silently see no
# non-terminal jobs to resume.
DATABASE_URL_SWEEP=

# --- Redis 7 (cache, locks, rate limits, idempotency, progress) ---
REDIS_URL=redis://localhost:6379/0

# --- Langfuse (traces, generations, scores, prompt registry) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Higgsfield MCP (video generation, behind the provider abstraction) ---
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_API_KEY=

# --- Delivery ---
STORAGE_BUCKET=
PRESIGNED_URL_TTL_SECONDS=3600
